# Environment / secrets
.env
*.env

# Python
venv/
.venv/
backend/venv/
backend/.venv/
__pycache__/
*.pyc

# Node
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
.npm-cache/
frontend/.npm-cache/

# Logs
*.log

# Generated files
storage/
exports/
backend/app/storage/
backend/storage/
*.pdf
# R3.5: the one deliberate exception to the blanket *.pdf rule above -- a
# synthetic, committed E2E fixture (generated by
# backend/scripts/generate_e2e_fixture.py), never a real/private plan. Kept
# as a narrow, explicit carve-out rather than loosening the blanket rule.
!frontend/e2e/fixtures/plan-fixture.pdf

# Local scratch / diagnostic output
test_plans/

# R3.5: Playwright's own generated debugging artifacts (screenshots,
# traces, HTML report) -- never committed, always regenerated by a run.
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Backups / legacy folders
_backup_before_flatten/
_recovery_candidates/
_live_before_validated_restore*/
massiq-mvp/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
