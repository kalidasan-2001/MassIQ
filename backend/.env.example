# Copy to backend/.env and adjust as needed. backend/.env is gitignored.

# Postgres connection used by the app and by `alembic upgrade`.
# Matches the docker-compose Postgres service at the repo root:
#   docker compose up -d postgres
# Host port is 5433, not the Postgres-standard 5432 -- this avoids colliding
# with any other local Postgres container/service already bound to 5432.
DATABASE_URL=postgresql+psycopg2://massiq:massiq@127.0.0.1:5433/massiq

# Optional -- enables AI-assisted floor-plan/legend/section analysis.
# Backend falls back gracefully to heuristic/manual workflow if unset.
OPENAI_API_KEY=
OPENAI_VLM_MODEL=gpt-4.1-mini
